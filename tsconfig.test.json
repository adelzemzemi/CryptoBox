{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["vitest/globals", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@core/*": ["src/core/*"],
      "@crypto/*": ["src/crypto/*"],
      "@security/*": ["src/security/*"],
      "@utils/*": ["src/utils/*"],
      "@storage/*": ["src/storage/*"],
      "@secure-storage/*": ["src/secure-storage/*"],
      "@factories/*": ["src/factories/*"],
      "@fingerprint/*": ["src/fingerprint/*"]
    }
  },
  "include": ["tests/**/*", "src/**/*"],
  "exclude": ["node_modules", "dist"]
}
