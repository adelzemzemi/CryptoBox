{
  "name": "@azemzemi/cryptobox",
  "version": "2.0.0",
  "type": "module",
  "description": "Zero-dependency encryption library for JavaScript & TypeScript. Secure localStorage, sessionStorage, or any data with AES-256-GCM encryption.",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./fingerprint": {
      "import": {
        "types": "./dist/fingerprint/index.d.ts",
        "default": "./dist/fingerprint/index.mjs"
      },
      "require": {
        "types": "./dist/fingerprint/index.d.cts",
        "default": "./dist/fingerprint/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.examples.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{src,tests,examples}/**/*.ts\" \"*.{json,md}\"",
    "format:check": "prettier --check \"{src,tests,examples}/**/*.ts\" \"*.{json,md}\"",
    "check:exports": "attw --pack . --profile node16",
    "check:package": "publint",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "verify": "npm run type-check && npm run lint && npm run format:check && npm run test:coverage && npm run build && npm run check:exports && npm run check:package",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "encryption",
    "storage",
    "security",
    "web-crypto",
    "aes-gcm",
    "aes-256",
    "pbkdf2",
    "crypto",
    "secure-storage",
    "token",
    "vault",
    "cryptography",
    "typescript",
    "browser",
    "nodejs",
    "deno",
    "bun"
  ],
  "author": {
    "name": "Adel Zemzemi",
    "url": "https://github.com/adelzemzemi"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adelzemzemi/cryptobox.git"
  },
  "bugs": {
    "url": "https://github.com/adelzemzemi/cryptobox/issues"
  },
  "homepage": "https://github.com/adelzemzemi/cryptobox#readme",
  "funding": "https://github.com/sponsors/adelzemzemi",
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.0.14",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^31.0.1",
    "prettier": "^3.3.0",
    "publint": "^0.3.12",
    "tsup": "^9.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.15.0",
    "vitest": "^4.0.14"
  }
}
